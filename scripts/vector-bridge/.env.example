# Copy to .env and fill in. Never commit the real file.

# Required. Shared secret the robot sends in the X-Vector-Token header.
# Generate with: openssl rand -hex 32
VECTOR_TOKEN=replace-me

# Optional. Local API that drives the robot's speech.
WIREPOD_URL=http://wirepod-host:8080
VECTOR_SERIAL=robot-serial

# Optional. Uptime monitor used by the "server status" command.
KUMA_URL=http://monitor-host:3001
KUMA_KEY=replace-me

# Optional. Approval gate that executes named write operations.
# Without it, write operations are refused.
APPROVAL_URL=http://approval-host:port/path

# Optional. Path to the named write-operation allowlist.
OPS_FILE=/opt/vector-bridge/ops.yaml
